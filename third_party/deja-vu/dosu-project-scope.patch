index 25258c9..ded140c 100644
--- a/internal/sources/claude.go
+++ b/internal/sources/claude.go
@@ -37,7 +37,24 @@ func LoadClaude() []model.Session {
 // ClaudeFiles lists the transcript files under the Claude root without parsing
 // them — a cheap count for diagnostics.
 func ClaudeFiles() []string {
-	return walkFiles(ClaudeRoot(), ClaudeFileWanted)
+	files := walkFiles(ClaudeRoot(), ClaudeFileWanted)
+	if len(projectScopeRoots()) == 0 {
+		return files
+	}
+	out := make([]string, 0, len(files))
+	for _, path := range files {
+		base := ClaudeProjectDirBase(path)
+		if resolved := ResolveEncodedPath(base); resolved != "" {
+			if projectScopeMatchesPath(resolved) {
+				out = append(out, path)
+			}
+			continue
+		}
+		if projectScopeMatchesProject(claudeProjectName(claudeProjectDir(path))) {
+			out = append(out, path)
+		}
+	}
+	return out
 }
 
