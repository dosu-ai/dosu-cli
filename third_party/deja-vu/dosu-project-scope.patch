+func scopeCodexRollouts(files []string) []string {
+	if len(projectScopeRoots()) == 0 {
+		return files
+	}
+	out := make([]string, 0, len(files))
+	for _, path := range files {
+		_, cwd := codexRolloutHead(path)
+		if projectScopeMatchesPath(cwd) {
+			out = append(out, path)
+		}
+	}
+	return out
+}
