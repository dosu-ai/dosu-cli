diff --git a/internal/sources/project_scope.go b/internal/sources/project_scope.go
new file mode 100644
index 0000000..78e6add
--- /dev/null
+++ b/internal/sources/project_scope.go
@@ -0,0 +1,160 @@
+package sources
+
+import (
+	"net/url"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+)
+
+type scopeRepositoryIdentity struct {
+	commonDir string
+	remote    string
+}
+
+var scopeRepositoryCache sync.Map
+
+// projectScopeRoots is the private runtime boundary used by Dosu Drive. An
+// empty value preserves deja's normal all-history behavior. Paths use the host
+// path-list separator so more than one selected repository can be supplied.
+func projectScopeRoots() []string {
+	raw := os.Getenv("DEJA_PROJECT_ROOTS")
+	if raw == "" {
+		return nil
+	}
+	var roots []string
+	seen := map[string]bool{}
+	for _, value := range filepath.SplitList(raw) {
+		value = canonicalScopePath(value)
+		if value == "" || seen[value] {
+			continue
+		}
+		seen[value] = true
+		roots = append(roots, value)
+	}
+	return roots
+}
+
+func canonicalScopePath(path string) string {
+	path = strings.TrimSpace(path)
+	if path == "" {
+		return ""
+	}
+	if absolute, err := filepath.Abs(path); err == nil {
+		path = absolute
+	}
+	if resolved, err := filepath.EvalSymlinks(path); err == nil {
+		path = resolved
+	}
+	return filepath.Clean(path)
+}
+
+func projectScopeMatchesPath(path string) bool {
+	path = canonicalScopePath(path)
+	if path == "" {
+		return false
+	}
+	for _, root := range projectScopeRoots() {
+		if rel, err := filepath.Rel(root, path); err == nil &&
+			(rel == "." || (rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) && !filepath.IsAbs(rel))) {
+			return true
+		}
+	}
+	if candidate, ok := scopeRepositoryAt(path); ok {
+		for _, root := range projectScopeRoots() {
+			selected, selectedOK := scopeRepositoryAt(root)
+			if !selectedOK {
+				continue
+			}
+			if candidate.commonDir != "" && candidate.commonDir == selected.commonDir {
+				return true
+			}
+			if candidate.remote != "" && candidate.remote == selected.remote {
+				return true
+			}
+		}
+		// An existing repository is identifiable. A different remote with the
+		// same basename is a different project, not a related worktree.
+		return false
+	}
+	// Deleted worktrees no longer have Git metadata to prove. Keep the current
+	// whole-segment fallback so historical sessions from a removed worktree do
+	// not disappear merely because its checkout was cleaned up.
+	return projectScopeMatchesProject(projectName(path))
+}
+
+func scopeRepositoryAt(path string) (scopeRepositoryIdentity, bool) {
+	path = canonicalScopePath(path)
+	if path == "" {
+		return scopeRepositoryIdentity{}, false
+	}
+	if cached, ok := scopeRepositoryCache.Load(path); ok {
+		identity := cached.(scopeRepositoryIdentity)
+		return identity, identity.commonDir != "" || identity.remote != ""
+	}
+	if _, err := os.Stat(path); err != nil {
+		scopeRepositoryCache.Store(path, scopeRepositoryIdentity{})
+		return scopeRepositoryIdentity{}, false
+	}
+	identity := scopeRepositoryIdentity{
+		commonDir: gitScopeValue(path, "rev-parse", "--path-format=absolute", "--git-common-dir"),
+		remote:    normalizeScopeRemote(gitScopeValue(path, "config", "--get", "remote.origin.url")),
+	}
+	identity.commonDir = canonicalScopePath(identity.commonDir)
+	scopeRepositoryCache.Store(path, identity)
+	return identity, identity.commonDir != "" || identity.remote != ""
+}
+
+func gitScopeValue(path string, args ...string) string {
+	cmdArgs := append([]string{"-C", path}, args...)
+	out, err := exec.Command("git", cmdArgs...).Output()
+	if err != nil {
+		return ""
+	}
+	return strings.TrimSpace(string(out))
+}
+
+func normalizeScopeRemote(remote string) string {
+	remote = strings.TrimSpace(remote)
+	if remote == "" {
+		return ""
+	}
+	if parsed, err := url.Parse(remote); err == nil && parsed.Host != "" {
+		remote = parsed.Host + "/" + strings.TrimPrefix(parsed.Path, "/")
+	} else if colon := strings.Index(remote, ":"); colon > 0 && !filepath.IsAbs(remote) {
+		host := remote[:colon]
+		if at := strings.LastIndex(host, "@"); at >= 0 {
+			host = host[at+1:]
+		}
+		remote = host + "/" + strings.TrimPrefix(remote[colon+1:], "/")
+	}
+	remote = strings.TrimSuffix(strings.TrimSuffix(remote, "/"), ".git")
+	return strings.ToLower(remote)
+}
+
+// projectScopeMatchesProject keeps the project-name fallback deja and Dosu
+// already expose: another checkout/worktree named "dosu" belongs to a selected
+// "dosu" repository. Exact-path matching above wins first; this fallback is
+// deliberately no broader than whole path segments.
+func projectScopeMatchesProject(project string) bool {
+	project = normalizeScopeProject(project)
+	if project == "" || project == "-" {
+		return false
+	}
+	for _, root := range projectScopeRoots() {
+		base := normalizeScopeProject(filepath.Base(root))
+		parentBase := normalizeScopeProject(filepath.Join(filepath.Base(filepath.Dir(root)), filepath.Base(root)))
+		if project == base || project == parentBase || strings.HasSuffix(project, "/"+base) {
+			return true
+		}
+	}
+	return false
+}
+
+func normalizeScopeProject(project string) string {
+	project = strings.ReplaceAll(strings.TrimSpace(project), `\`, "/")
+	project = strings.TrimPrefix(project, "imported:")
+	return strings.ToLower(strings.Trim(project, "/"))
+}
