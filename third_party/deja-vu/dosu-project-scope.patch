@@ -0,0 +1,31 @@
+package sources
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"sync"
+)
+
+const scanProgressPrefix = "@dosu-scan "
+
+var scanProgressMu sync.Mutex
+
+func scanProgressLine(path string) string {
+	payload, _ := json.Marshal(struct {
+		Path string `json:"path"`
+	}{Path: path})
+	return scanProgressPrefix + string(payload)
+}
+
+// reportScanPath is inert for normal deja users. Dosu's private runtime turns
+// it on and consumes the machine-readable stderr lines to update one spinner
+// in place; the paths never accumulate in the terminal scrollback.
+func reportScanPath(path string) {
+	if os.Getenv("DEJA_SCAN_PROGRESS") != "1" {
+		return
+	}
+	scanProgressMu.Lock()
+	defer scanProgressMu.Unlock()
+	fmt.Fprintln(os.Stderr, scanProgressLine(path))
+}
